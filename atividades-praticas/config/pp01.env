# Nome do check exigido na branch. O formato "X / X" é como o GitHub
# nomeia o check-run de um job que chama um workflow reutilizável
# ("<job do chamador> / <job do workflow chamado>") — só ajuste se você
# renomear o job no template ou no kit.
CHECK_RELATO="validar-relato / validar-relato"

# Repositório privado (evita que um aluno veja a solução do outro).
PRIVADO="true"
