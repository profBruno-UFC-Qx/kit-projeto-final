# Copie este arquivo para dentro da pasta de gestão da sua disciplina
# (ex: GestaoProjetoFinal/qxd0020.env) e ajuste os valores.

ORG="profBruno-UFC-Qx"
TEMPLATE_REPO="profBruno-UFC-Qx/qxd0020-projeto-final"
PREFIXO_REPO="qxd0020"

# Nomes dos checks exigidos na branch main. O formato "X / X" é como o
# GitHub nomeia o check-run de um job que chama um workflow reutilizável
# ("<job do chamador> / <job do workflow chamado>") — só ajuste se você
# renomear os jobs no template da disciplina ou no kit.
CHECK_PROPOSTA="validar-proposta / validar-proposta"
CHECK_ENTREGA="validar-entrega / validar-entrega"
